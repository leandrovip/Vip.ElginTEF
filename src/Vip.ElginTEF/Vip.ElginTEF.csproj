<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Title>Vip.ElginTEF</Title>
    <Company>Leandro Ferreira</Company>
    <Description>Biblioteca para controle e fluxo de transações eletrônicas via TEF Elgin</Description>
    <Copyright>VIP Soluções</Copyright>
    <PackageProjectUrl>https://github.com/leandrovip/Vip.ElginTEF</PackageProjectUrl>
    <RepositoryUrl>https://github.com/leandrovip/Vip.ElginTEF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>vip, tef, elgin</PackageTags>
    <PackageReleaseNotes>Versão Inicial</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExtraConstraints.Fody" Version="1.14.0" />
    <PackageReference Include="Fody" Version="6.5.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
